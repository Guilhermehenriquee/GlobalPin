generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  PAYABLE
  RECEIVABLE
}

enum TransactionStatus {
  PENDING
  PAID
  RECEIVED
  CANCELED
}

enum ProjectCategory {
  SPORTS
  ELECTRONICS
  SYSTEMS
  SERVICES
  OTHER
}

enum ProjectStatus {
  PENDING
  PAID
  CANCELED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum NewsCategory {
  SPORTS
  ELECTRONICS
  TECH
  FINANCE
  BUSINESS
}

enum FinancialGoal {
  PAY_OFF_DEBT
  SAVE_MONEY
  INVEST_BETTER
  BUY_CAR
  BUY_HOUSE
  EMERGENCY_RESERVE
  CONTROL_CARD
  TRACK_NET_WORTH
}

enum InvestorProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum FinancialKnowledgeLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BankConnectionStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
  ERROR
}

enum ConsentStatus {
  PENDING
  AUTHORIZED
  REVOKED
  EXPIRED
}

enum BankAccountType {
  CHECKING
  SAVINGS
  PAYMENT
  INVESTMENT
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

enum TransactionForm {
  PIX
  CARD
  BOLETO
  DEBIT
  TRANSFER
  TED
  DOC
  INVESTMENT
  LOAN
  OTHER
}

enum TransactionSource {
  MANUAL
  OPEN_FINANCE
  IMPORT
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum InvestmentType {
  CDB
  TREASURY
  FII
  STOCK
  FUND
  CRYPTO
  SAVINGS
  OTHER
}

enum InvestmentRisk {
  LOW
  MEDIUM
  HIGH
}

enum InvestmentLiquidity {
  DAILY
  MATURITY
  VARIABLE
}

enum AlertType {
  SALARY_RECEIVED
  CARD_INCREASE
  DUPLICATE_CHARGE
  UNUSED_SUBSCRIPTION
  NEGATIVE_BALANCE_RISK
  ANOMALY
  SAVING_OPPORTUNITY
  BUDGET_LIMIT
  GENERAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum InsightType {
  CATEGORY_ANALYSIS
  ANOMALY
  RECOMMENDATION
  FORECAST
  SUBSCRIPTION
  DEBT
}

enum AiConversationRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FinancialProfileType {
  PERSONAL
  BUSINESS
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  salary        Decimal        @default(0) @db.Decimal(12, 2)
  financialGoals FinancialGoal[]
  investorProfile InvestorProfile?
  financialKnowledge FinancialKnowledgeLevel @default(BEGINNER)
  transactions  Transaction[]
  projects      Project[]
  notifications Notification[]
  aiReports     AiReport[]
  newsItems     NewsItem[]
  bankConnections BankConnection[]
  openFinanceConsents OpenFinanceConsent[]
  bankAccounts  BankAccount[]
  budgets       Budget[]
  goals         Goal[]
  cards         Card[]
  investments   Investment[]
  insights      FinancialInsight[]
  alerts        Alert[]
  newsPreferences UserNewsPreference[]
  aiConversations AiConversation[]
  financialProfiles FinancialProfile[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FinancialProfile {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         FinancialProfileType
  document     String?
  color        String?
  transactions Transaction[]
  projects     Project[]
  budgets      Budget[]
  goals        Goal[]
  cards        Card[]
  investments  Investment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId, type])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  description  String?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([name])
}

model Transaction {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId    String?
  profile      FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  bankAccountId String?
  bankAccount  BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title        String
  amount       Decimal           @db.Decimal(12, 2)
  type         TransactionType
  direction    TransactionDirection?
  form         TransactionForm?
  source       TransactionSource @default(MANUAL)
  externalId   String?
  status       TransactionStatus @default(PENDING)
  originalDescription String?
  categoryName String?
  subcategory  String?
  merchant     String?
  recurrence   String?
  tag          String?
  dueDate      DateTime
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, type])
  @@index([profileId])
  @@index([bankAccountId])
  @@unique([userId, source, externalId])
}

model Project {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String?
  profile   FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  title     String
  client    String
  category  ProjectCategory
  amount    Decimal         @db.Decimal(12, 2)
  status    ProjectStatus   @default(PENDING)
  soldAt    DateTime
  paidAt    DateTime?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, soldAt])
  @@index([userId, status])
  @@index([profileId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model AiReport {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   Json
  createdAt DateTime @default(now())
}

model NewsItem {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  url         String?
  source      String?
  category    NewsCategory?
  relevance   Int      @default(0)
  isRelevant  Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BankConnection {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  bankName    String
  status      BankConnectionStatus @default(PENDING)
  consentId   String?
  metadata    Json?
  expiresAt   DateTime?
  revokedAt   DateTime?
  accounts    BankAccount[]
  consents    OpenFinanceConsent[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, status])
}

model OpenFinanceConsent {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConnectionId String?
  bankConnection   BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  externalId       String?
  status           ConsentStatus @default(PENDING)
  permissions      String[]
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, status])
}

model BankAccount {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConnectionId String?
  bankConnection   BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  externalId       String?
  bankName         String
  agency           String?
  accountNumber    String?
  accountType      BankAccountType @default(CHECKING)
  currentBalance   Decimal         @default(0) @db.Decimal(12, 2)
  availableBalance Decimal         @default(0) @db.Decimal(12, 2)
  transactions     Transaction[]
  cards            Card[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@unique([userId, externalId])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String?
  profile   FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  month     Int
  year      Int
  alertAt   Int      @default(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId     String?
  profile       FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  title         String
  targetAmount  Decimal  @db.Decimal(12, 2)
  currentAmount Decimal  @default(0) @db.Decimal(12, 2)
  deadline      DateTime?
  monthlyTarget Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([profileId])
}

model Card {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId       String?
  profile         FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  bankAccountId   String?
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  externalId      String?
  name            String
  brand           CardBrand @default(OTHER)
  totalLimit      Decimal   @default(0) @db.Decimal(12, 2)
  usedLimit       Decimal   @default(0) @db.Decimal(12, 2)
  availableLimit  Decimal   @default(0) @db.Decimal(12, 2)
  closingDay      Int?
  dueDay          Int?
  bestPurchaseDay Int?
  invoices        Invoice[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([profileId])
  @@unique([userId, externalId])
}

model Invoice {
  id        String        @id @default(uuid())
  cardId    String
  card      Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  dueDate   DateTime
  closedAt  DateTime?
  paidAt    DateTime?
  status    InvoiceStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([cardId, status])
}

model Investment {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId   String?
  profile     FinancialProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  externalId  String?
  institution String
  product     String
  type        InvestmentType
  amount      Decimal             @db.Decimal(12, 2)
  profitability String?
  maturity    DateTime?
  risk        InvestmentRisk      @default(LOW)
  liquidity   InvestmentLiquidity @default(DAILY)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId, type])
  @@index([profileId])
  @@unique([userId, externalId])
}

model FinancialInsight {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      InsightType
  title     String
  message   String
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([userId, type])
}

model Alert {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AlertType     @default(GENERAL)
  severity  AlertSeverity @default(MEDIUM)
  title     String
  message   String
  read      Boolean       @default(false)
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, read])
}

model UserNewsPreference {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NewsCategory
  keyword   String?
  createdAt DateTime     @default(now())

  @@index([userId, category])
}

model AiConversation {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiConversationRole
  content   String
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
}
